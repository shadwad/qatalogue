{
  "name": "qatalogue",
  "private": true,
  "version": "0.1.0",
  "description": "An open bibliometric explorer for quantum information science and technology",
  "author": {
    "name": "Shadnan Azwad Khan",
    "url": "https://orcid.org/0000-0003-2769-6856"
  },
  "license": "MIT",
  "homepage": "https://qatalogue.org",
  "repository": "https://github.com/shadwad/qatalogue",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/server.ts",
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*/*.test.ts",
    "link-codes": "tsx scripts/link-codes.ts",
    "locations": "tsx scripts/build-locations.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/special-gothic-expanded-one": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "cldr-core": "48.2.0",
    "cldr-localenames-full": "48.2.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "d3-polygon": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-types": "^0.24.8",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.79.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "world-atlas": "^2.0.2"
  }
}
